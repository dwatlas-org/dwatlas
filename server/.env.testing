ENVIRONMENT=testing
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-password
POSTGRES_DB=postgres

SQLITE_DB_PATH=app.db

AUTH_SECRET_KEY=replace-auth-secret-key-with-a-23-bytes-long-secret-hash
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

REQUEST_ACCESS_FROM=replace-with-request-source-email-address
REQUEST_ACCESS_TO=replace-with-request-target-email-address

EMAIL_PROVIDER=console

EMAIL_SMTP_USER=replace-with-smtp-user
EMAIL_SMTP_PASSWORD=replace-with-smtp-password
EMAIL_SMTP_HOST=replace-with-smtp-host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS=True

EMAIL_MAILERSEND_ADDRESS=replace-with-mailersend-api-address
EMAIL_MAILERSEND_TOKEN=replace-with-mailersend-api-token
